<?xml version='1.0' encoding='utf-8'?>
<Defs>
 
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Red_tide</defName>
    <label>Bullet Red tide</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.85</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>18</damageAmountBase>
      <armorPenetrationBase>0.88</armorPenetrationBase>
	  <stoppingPower>2</stoppingPower>
      <screenShakeFactor>0</screenShakeFactor>
      <speed>100</speed>
    </projectile>
  <comps>
    <li Class="NCL.CompProperties_FragmentedExplosive">
      <explosionRadius>3.5</explosionRadius>
      <fragmentCount>3</fragmentCount> 
      <guaranteedCenterFraction>0.33</guaranteedCenterFraction> 
      <fragmentProjectileDef>Bullet_NCL_Fragments</fragmentProjectileDef>
      <fireGlowSize>0.5</fireGlowSize>
      <heatGlowSize>0</heatGlowSize>
      <smokeSize>0</smokeSize>
    </li>
  </comps>
  </ThingDef>
  
  <ThingDef ParentName="BaseIncendiaryProjectile">
    <defName>Crimson_Slagburst_Rocket</defName>
    <label>Crimson Slagburst Rocket</label>
    <graphicData>
      <texPath>Things/Projectile/LauncherShot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1</drawSize>
      <shaderType>TransparentPostLight</shaderType>
      <color>(254,189,58)</color>
    </graphicData>
    <projectile>
	  <damageDef>Crimson_Slagburst</damageDef>
	  <damageAmountBase>16</damageAmountBase>
      <speed>120</speed>
      <screenShakeFactor>0</screenShakeFactor>
	  <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
    <armorPenetrationBase>1</armorPenetrationBase>
	  <ai_IsIncendiary>true</ai_IsIncendiary>
      <explosionRadius>0.8</explosionRadius>
	  <arcHeightFactor>0</arcHeightFactor>
    </projectile>
  </ThingDef>
  
  <ThingDef ParentName="BaseGun">
    <defName>NCL_Redtide</defName>
    <label>Redtide</label>
    <description>Redtide</description>
    <tradeability>None</tradeability>
    <relicChance>0</relicChance>
    <graphicData>
      <texPath>Things/None</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.8</drawSize>
    </graphicData>
	<uiIconPath>Things/RedtideUI</uiIconPath>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses>
      <li>LongShots</li>
      <li>RangedHeavy</li>
    </weaponClasses>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>36</Mass>
      <AccuracyTouch>0.7</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.4</AccuracyMedium>
      <AccuracyLong>0.2</AccuracyLong>
      <RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
    </statBases>
    <smeltable>false</smeltable>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>3</ticksBetweenBurstShots>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Crimson_Slagburst_Rocket</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>32</range>
        <soundCast>Shot_Autocannon</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <forcedMissRadius>0.1</forcedMissRadius>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>40</power>
        <cooldownTime>1</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>40</power>
        <cooldownTime>1</cooldownTime>
      </li>
    </tools>
    <weaponTags Inherit="False">
      <li>RedT03</li>
    </weaponTags>
	<tradeTags>
      <li>NCLThings</li>
    </tradeTags>
  </ThingDef>
  
  <ThingDef Name="RT_AutoGun" ParentName="BaseWeaponTurret">
    <defName>RT_AutoGun</defName>
    <label>RT AutoGun</label>
    <description>RT AutoGun</description>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <graphicData>
      <texPath>Things/None</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>10</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
    </statBases>
    <verbs>
      <li>
				<verbClass>Verb_ArcSprayProjectile</verbClass>
				<sprayWidth>2.5</sprayWidth>
				<sprayArching>1</sprayArching>
				<sprayThicknessCells>10</sprayThicknessCells>
				<sprayNumExtraCells>15</sprayNumExtraCells>
				<consumeFuelPerBurst>0</consumeFuelPerBurst>

				<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
				<burstShotCount>15</burstShotCount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Red_tide</defaultProjectile>
				<defaultCooldownTime>2</defaultCooldownTime>
				<minRange>3</minRange>
				<range>35</range>
				<soundCast>Shot_Autocannon</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>7</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<forcedMissRadius>0</forcedMissRadius>
      </li>
    </verbs>
	<tradeTags>
      <li>NCLThings</li>
    </tradeTags>
  </ThingDef>

  <!-- Duplicate defs so RsPandaLibrary.CompMultiTurretGun save/load can match TurretProperties per gun (FirstOrDefault by turretDef). -->
  <ThingDef ParentName="RT_AutoGun">
    <defName>NCL_Scorpion_RT_AutoGun_Left</defName>
    <label>RT AutoGun (L)</label>
  </ThingDef>
  <ThingDef ParentName="RT_AutoGun">
    <defName>NCL_Scorpion_RT_AutoGun_Right</defName>
    <label>RT AutoGun (R)</label>
  </ThingDef>

  <!-- Tail-mounted Solaris Penetrator (replaces NCL_Blazing_Core_Penetrator ability for CompMultiTurretGun). -->
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>NCL_Scorpion_SolarisPenetrator</defName>
    <label>Solaris Penetrator</label>
    <description>Tail-mounted hellsphere projector (War Scorpion).</description>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <graphicData>
      <texPath>Things/SolarisPenetratorCannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>40</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_HellsphereCannonGun</defaultProjectile>
        <warmupTime>5</warmupTime>
        <defaultCooldownTime>5</defaultCooldownTime>
        <minRange>11.4</minRange>
        <range>35</range>
        <requireLineOfSight>false</requireLineOfSight>
        <soundCast>Shot_HellsphereCannonGun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <ai_AvoidFriendlyFireRadius>8</ai_AvoidFriendlyFireRadius>
        <ai_RangedAlawaysShootGroundBelowTarget>true</ai_RangedAlawaysShootGroundBelowTarget>
        <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <ai_TargetHasRangedAttackScoreOffset>50</ai_TargetHasRangedAttackScoreOffset>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>true</canTargetPawns>
          <canTargetBuildings>true</canTargetBuildings>
        </targetParams>
        <aimingLineMote>Mote_HellsphereCannon_Aim</aimingLineMote>
        <aimingChargeMote>Mote_HellsphereCannon_Charge</aimingChargeMote>
        <aimingChargeMoteOffset>1.07</aimingChargeMoteOffset>
        <aimingLineMoteFixedLength>15.9</aimingLineMoteFixedLength>
        <aimingTargetMote>Mote_HellsphereCannon_Target</aimingTargetMote>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>30</ticksBetweenBurstShots>
        <beamTargetsGround>true</beamTargetsGround>
        <soundAiming>HellsphereCannon_Aiming</soundAiming>
        <canGoWild>false</canGoWild>
      </li>
    </verbs>
    <tradeTags>
      <li>NCLThings</li>
    </tradeTags>
  </ThingDef>
  
  </Defs>