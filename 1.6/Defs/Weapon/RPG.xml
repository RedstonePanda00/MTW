<Defs>

  <ThingDef ParentName="BaseGun">
    <defName>TW_Guided_Rocket_Launcher_HE</defName>
    <label>HE Guided Rocket Launcher</label>
    <description>Fires target-tracking high-explosive warheads for precision demolition.</description>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <tickerType>Normal</tickerType>
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
	<uiIconPath>Weapons/TW_Guided_Rocket_Launcher_HE</uiIconPath>
    <graphicData>
      <texPath>Weapons/TW_Guided_Rocket_Launcher_HE</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.2</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>1000</MarketValue>
      <Mass>8</Mass>
      <RangedWeapon_Cooldown>4.5</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>TW_Guided_Rocket_Launcher_HE</li>
    </weaponTags>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <tradeTags>
      <li>NCLThings</li>
    </tradeTags>
    <relicChance>0</relicChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>TW_HE_Guided_Missile</defaultProjectile>
        <forcedMissRadius>0.1</forcedMissRadius>
        <warmupTime>3.5</warmupTime>
        <ai_AvoidFriendlyFireRadius>8</ai_AvoidFriendlyFireRadius>
        <range>35</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>InfernoCannon_Fire</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <onlyManualCast>true</onlyManualCast>
        <targetParams>
        <canTargetLocations>false</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        </targetParams>
        <muzzleFlashScale>14</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>11.7</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
