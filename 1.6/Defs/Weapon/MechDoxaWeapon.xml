    </graphicData>
    <uiIconScale>1</uiIconScale>
    <weaponTags>
      <li>Legendary</li>
    </weaponTags>
    <weaponClasses>
      <li>LongShots</li>
      <li>RangedHeavy</li>
    </weaponClasses>
    <statBases>
      <Mass>0.5</Mass>
    </statBases>
	<equippedStatOffsets>
	 <MeleeHitChance>8</MeleeHitChance>
     </equippedStatOffsets>
	<tradeTags>
      <li>NCLThings</li>
    </tradeTags>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>0.5</cooldownTime>
      </li>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>15</power>
        <cooldownTime>0.5</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>30</power>
        <cooldownTime>0.5</cooldownTime>
      </li>
    </tools>
  </ThingDef>
  
</Defs>