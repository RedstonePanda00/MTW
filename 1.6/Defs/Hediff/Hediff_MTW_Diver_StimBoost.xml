<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>MTW_Diver_StimBoost</defName>
    <label>Stim</label>
    <description>Nanomachines are rapidly repairing the diver's injuries.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.35, 0.85, 0.55)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.5</MoveSpeed>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="RsPandaLibrary.HediffCompProperties_Regeneration">
        <regenerationRate>100</regenerationRate>
        <tickInterval>60</tickInterval>
      </li>
    </comps>
  </HediffDef>

</Defs>
