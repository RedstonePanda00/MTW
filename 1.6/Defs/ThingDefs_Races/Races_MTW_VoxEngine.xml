<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BaseMechanoid">
    <defName>MTW_VoxEngine</defName>
    <label>vox engine</label>
    <description>A heavy multi-cell mechanoid built around a rotating tread chassis. The upper hull snaps to facing while the base chassis slews toward movement direction.</description>
    <statBases>
      <MarketValue>4800</MarketValue>
      <MoveSpeed>1.6</MoveSpeed>
      <ArmorRating_Blunt>0.55</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.85</ArmorRating_Sharp>
      <PsychicSensitivity>0</PsychicSensitivity>
      <BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">12</BandwidthCost>
      <MechEnergyLossPerHP MayRequire="Ludeon.RimWorld.Biotech">0.2</MechEnergyLossPerHP>
    </statBases>
    <size>(3,3)</size>
    <tools>
      <li>
        <label>chassis</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>28</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <race>
      <body>VoxEngineBody</body>
      <baseBodySize>3.6</baseBodySize>
      <baseHealthScale>2.4</baseHealthScale>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>Mechanoid</thinkTreeMain>
      <mechWeightClass>Heavy</mechWeightClass>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidBash_Miss</soundMeleeMiss>
      <lifeStageAges Inherit="false">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Centipede_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Centipede_Death</soundDeath>
          <soundCall>Pawn_Mech_Centipede_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <comps>
      <li Class="NCL.CompProperties_MultiCellPawn">
        <version>1</version>
        <showOverlayWhenSelected>true</showOverlayWhenSelected>
        <showDebugLabels>false</showDebugLabels>
        <rebuildProxyOnLoad>true</rebuildProxyOnLoad>
        <coreCellColor>(0.25, 0.50, 0.95)</coreCellColor>
        <healthColorThresholdHigh>0.7</healthColorThresholdHigh>
        <healthColorThresholdMid>0.35</healthColorThresholdMid>
        <showPartHealthGizmo>true</showPartHealthGizmo>
        <parts>
          <li>
            <partKey>body</partKey>
            <bindBodyPartDef>VoxEngine_Core</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>5</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(0,0,0)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_NW</partKey>
            <bindBodyPartDef>VoxEngine_Shell_NW</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(-1,0,1)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_N</partKey>
            <bindBodyPartDef>VoxEngine_Shell_N</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(0,0,1)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_NE</partKey>
            <bindBodyPartDef>VoxEngine_Shell_NE</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(1,0,1)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_W</partKey>
            <bindBodyPartDef>VoxEngine_Shell_W</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(-1,0,0)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_E</partKey>
            <bindBodyPartDef>VoxEngine_Shell_E</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(1,0,0)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_SW</partKey>
            <bindBodyPartDef>VoxEngine_Shell_SW</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(-1,0,-1)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_S</partKey>
            <bindBodyPartDef>VoxEngine_Shell_S</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(0,0,-1)</li>
            </cellsNorth>
          </li>
          <li>
            <partKey>part_VoxEngine_Shell_SE</partKey>
            <bindBodyPartDef>VoxEngine_Shell_SE</bindBodyPartDef>
            <canBeTargeted>true</canBeTargeted>
            <priority>10</priority>
            <damageMultiplier>1.0</damageMultiplier>
            <armorFactor>1.0</armorFactor>
            <cellsNorth>
              <li>(1,0,-1)</li>
            </cellsNorth>
          </li>
        </parts>
      </li>
      <li Class="NCL.CompProperties_VoxEngineChassis">
        <angularVelocityDegPerSec>45</angularVelocityDegPerSec>
        <baseTexPath>Things/VoxEngine/Vox_Base</baseTexPath>
        <baseSideTexPath>Things/VoxEngine/Vox_Base_side</baseSideTexPath>
        <sideSwitchHysteresisDeg>0</sideSwitchHysteresisDeg>
        <cardinalBandDeg>45</cardinalBandDeg>
        <baseDrawSize>4.5</baseDrawSize>
        <baseLayer>-10</baseLayer>
        <renderNodeProperties>
          <li>
            <debugLabel>VoxEngineBase</debugLabel>
            <nodeClass>NCL.PawnRenderNode_VoxEngineBase</nodeClass>
            <workerClass>NCL.PawnRenderNodeWorker_VoxEngineBase</workerClass>
            <parentTagDef>Body</parentTagDef>
            <pawnType>Any</pawnType>
            <rotateIndependently>true</rotateIndependently>
            <baseLayer>-10</baseLayer>
            <drawSize>(4.5, 4.5)</drawSize>
            <texPath>Things/VoxEngine/Vox_Base</texPath>
          </li>
        </renderNodeProperties>
      </li>
    </comps>
    <butcherProducts>
      <Steel>320</Steel>
      <Plasteel>80</Plasteel>
    </butcherProducts>
  </ThingDef>

  <PawnKindDef ParentName="BaseMechanoidKind">
    <defName>MTW_VoxEngine_Kind</defName>
    <label>vox engine</label>
    <race>MTW_VoxEngine</race>
    <combatPower>420</combatPower>
    <maxPerGroup>2</maxPerGroup>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/VoxEngine/Vox</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>4.5</drawSize>
          <shadowData>
            <volume>(1.2, 0.8, 1.2)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
