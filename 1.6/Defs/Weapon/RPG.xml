          <li>RimWorld.CompProperties_Biocodable</li>
          <li>RimWorld.CompBiocodable</li>
          <li>RimWorld.CompQuality</li>
          <li>RimWorld.CompProperties_Art</li>
          <li>RimWorld.CompArt</li>
