<?xml version='1.0' encoding='utf-8'?>
<Defs>
  
  <ThingDef ParentName="BaseBullet">
    <defName>Shell_TW_Antiparticle_Rail_Mortar</defName>
    <label>HE Tactical Warhead</label>
    <graphicData>
      <texPath>Projectiles/Shell_Nuclear_Bomb</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
	  <drawSize>3</drawSize>
    </graphicData>
    <thingClass>NCL.Projectiles.Projectile_DoxaClusterWarhead</thingClass>
    <projectile>
      <damageDef>TW_Antiparticle_explosion</damageDef>
      <damageAmountBase>35</damageAmountBase>
      <explosionRadius>5</explosionRadius>
      <speed>40</speed>
      <shadowSize>3</shadowSize>
      <arcHeightFactor>40</arcHeightFactor>
      <flyOverhead>true</flyOverhead>
    </projectile>
    <modExtensions>
      <li Class="NCL.Projectiles.ModExtension_ProjectileHighArc">
        <arcPeakHeight>70</arcPeakHeight>
      </li>
      <li Class="NCL.Projectiles.ModExtension_ProjectileCluster">
        <primaryDamage>35</primaryDamage>
        <primaryRadius>5</primaryRadius>
        <subProjectileDef>Proj_MTW_Doxa_ClusterSub_HE</subProjectileDef>
        <submunitionCount>25</submunitionCount>
        <spreadRadiusCells>10</spreadRadiusCells>
        <angleJitterDegrees>4</angleJitterDegrees>
        <radiusJitterCells>1</radiusJitterCells>
      </li>
    </modExtensions>
	<comps>
      <li Class="NCL.CompProperties_SmokeTrail">
        <intervalTicks>2</intervalTicks>
        <smokeSize>1</smokeSize>
      </li>
      <li Class="NCL.Projectiles.CompProperties_SpawnClusterSubmunitionsOnDestroy" />
	  <li Class="NCL.CompProperties_SpawnFleckEffectOnDestroyed">
            
            <globalScaleFactor>1.5</globalScaleFactor>
            
            
            <flecks>
                
                <li>
                    <fleckDef>Smoke</fleckDef>
                    <count>20</count>          
                    <scale>2.0</scale>         
                    <maxOffset>1.8</maxOffset> 
                    <velocityAngle>90</velocityAngle> 
                    <velocitySpeed>0.8</velocitySpeed>
                    <durationTicks>180</durationTicks>
                </li>
                
                
                <li>
                    <fleckDef>ExplosionFlash</fleckDef>
                    <count>15</count>
                    <scale>1.2</scale>
                    <maxOffset>2.5</maxOffset>
                    <rotationRate>90</rotationRate> 
                    <solidTime>0.5</solidTime>      
                </li>
            </flecks>
            
            
            <effects>
                <li>
                    <effectDef>GiantExplosion</effectDef>
                    <count>1</count>
                    <durationTicks>600</durationTicks> 
                </li>
                
                <li>
                    <effectDef>GiantExplosion</effectDef>
                    <count>1</count>
                    <maxOffset>0.3</maxOffset>
                </li>
            </effects>
        </li>
    </comps>
  </ThingDef>
  
