<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <ThingDef ParentName="BaseGun">
    <defName>NCL_AssaultTrooper_ChargeRifle</defName>
    <label>assault charge rifle</label>
    <description>A charge rifle refitted for the Assault Trooper. Pulse-charge technology loads each shot with unstable energy that is released on impact.</description>
    <techLevel>Spacer</techLevel>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <relicChance>0</relicChance>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>Races/AssaultTrooper/ExplosiveChargeRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <uiIconPath>Races/AssaultTrooper/ExplosiveChargeRifle</uiIconPath>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <statBases>
      <!-- PawnWeaponGenerator weights candidates by price. A zero-value gun is never equipped. -->
      <MarketValue>1400</MarketValue>
      <Mass>4.6</Mass>
      <AccuracyTouch>0.55</AccuracyTouch>
      <AccuracyShort>0.64</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.45</AccuracyLong>
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ChargeRifle</defaultProjectile>
        <warmupTime>1</warmupTime>
        <range>27.9</range>
        <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags Inherit="False">
      <li>NCL_AssaultTrooper_ChargeRifle</li>
    </weaponTags>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_NCL_AssaultTrooperShoulderCannon</defName>
    <label>shoulder cannon shell</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>16</damageAmountBase>
      <armorPenetrationBase>0.35</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>70</speed>
    </projectile>
  </ThingDef>

  <!-- Mounted through RsPandaLibrary.CompMultiTurretGun on the Assault Trooper's shoulder. -->
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>NCL_AssaultTrooper_ShoulderCannon</defName>
    <label>shoulder cannon</label>
    <description>A compact shoulder-mounted cannon that tracks and engages targets on its own while the Assault Trooper fights with its rifle.</description>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <graphicData>
      <texPath>Races/AssaultTrooper/ShoulderCannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>8</Mass>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.7</AccuracyShort>
      <AccuracyMedium>0.5</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_NCL_AssaultTrooperShoulderCannon</defaultProjectile>
        <warmupTime>0.6</warmupTime>
        <defaultCooldownTime>3.5</defaultCooldownTime>
        <range>24.9</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>8</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

</Defs>
