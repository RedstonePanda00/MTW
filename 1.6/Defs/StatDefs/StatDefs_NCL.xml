<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Used by HediffComp_ReactOnDamage EMP prefix: chance to resist brain shock / vomiting (0-1, PercentZero). -->
    <!-- No workerClass: StatDef defaults to RimWorld.StatWorker (see StatDef.workerClass in game source). -->
    <StatDef>
        <defName>NCL_BrainShockResistance</defName>
        <label>brain shock resistance</label>
        <description>Chance to resist mental break side effects from EMP damage reactions.</description>
        <category>BasicsPawn</category>
        <defaultBaseValue>0</defaultBaseValue>
        <minValue>0</minValue>
        <maxValue>1</maxValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showIfUndefined>false</showIfUndefined>
        <showOnPawns>false</showOnPawns>
        <displayPriorityInCategory>9990</displayPriorityInCategory>
    </StatDef>

    <!-- Pawn combat stat: multiplied onto Verb_LaunchProjectile.EffectiveRange via Harmony (replaces VEF_VerbRangeFactor). -->
    <StatDef>
        <defName>NCL_VerbRangeFactor</defName>
        <label>verb range factor</label>
        <description>Multiplier applied to ranged verb effective range from this pawn.</description>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <minValue>0.01</minValue>
        <hideAtValue>1</hideAtValue>
        <alwaysHide>true</alwaysHide>
        <toStringStyle>PercentZero</toStringStyle>
        <displayPriorityInCategory>1210</displayPriorityInCategory>
    </StatDef>
</Defs>
