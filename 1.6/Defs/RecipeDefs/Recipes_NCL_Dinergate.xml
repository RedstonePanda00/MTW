<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Reference recipe for research UI only: not assigned to any workbench (no mech gestator bills). -->
  <RecipeDef ParentName="BaseMechanoidRecipe">
    <defName>NCL_Mech_Dinergate</defName>
    <label>Dinergate</label>
    <gestationCycles>8</gestationCycles>
    <displayPriority>150</displayPriority>
    <description>Dinergate is an NCL military-grade humanoid mechanoid. It can equip ranged weapons. It reaches the battlefield via Star Devourer squad drop pods, with three units per pod.
As for how NCL mass-produces these mechanoids, and why drop pods descend even when no ships are visible in orbit, they only say: "We have allies with powerful logistics."</description>
    <researchPrerequisite Inherit="false" />
    <researchPrerequisites>
      <li>HighMechtech</li>
      <li>NCL_Heavyforge_Units</li>
    </researchPrerequisites>
    <recipeUsers Inherit="False" />
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>400</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>120</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>NCL_Neural_Weave</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>NCL_Microfusion_Reactor</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <NCL_Mech_Dinergate>1</NCL_Mech_Dinergate>
    </products>
    <descriptionHyperlinks>
      <ThingDef>NCL_Mech_Dinergate</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>

</Defs>
