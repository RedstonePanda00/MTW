<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Replace vanilla charge blaster bulb turret with bilateral RT mounts (hellsphere targeting beam unchanged). -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="Mech_Diabolus"]/comps/li[@Class="CompProperties_TurretGun"]</xpath>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Mech_Diabolus"]/comps</xpath>
    <value>
      <li Class="RsPandaLibrary.CompProperties_MultiTurretGun">
        <saveKeysPrefix>NCLDiabolusMultiTurret_</saveKeysPrefix>
        <turrets>
          <li>
            <turretDef>NCL_Diabolus_RT_AutoGun_Left</turretDef>
            <warmupTime>0.05</warmupTime>
            <cooldownTime>4</cooldownTime>
            <renderTurretGraphic>true</renderTurretGraphic>
            <renderNodeProperties>
              <nodeClass>RsPandaLibrary.PawnRenderNode_MultiTurretGun</nodeClass>
              <workerClass>RsPandaLibrary.PawnRenderNodeWorker_MultiTurretGun</workerClass>
              <parentTagDef>Body</parentTagDef>
              <overrideMeshSize>(0.5, 0.5)</overrideMeshSize>
              <baseLayer>20</baseLayer>
              <pawnType>Any</pawnType>
              <drawData>
                <defaultData>
                  <rotationOffset>-90</rotationOffset>
                </defaultData>
                <dataWest>
                  <rotationOffset>90</rotationOffset>
                </dataWest>
              </drawData>
            </renderNodeProperties>
            <turretOffsetNorth>(-0.6, 0, 0.8)</turretOffsetNorth>
            <turretOffsetSouth>(0.6, 0, -0.8)</turretOffsetSouth>
            <turretOffsetEast>(0.8, 0, -0.6)</turretOffsetEast>
            <turretOffsetWest>(-0.8, 0, -0.6)</turretOffsetWest>
          </li>
          <li>
            <turretDef>NCL_Diabolus_RT_AutoGun_Right</turretDef>
            <warmupTime>0.05</warmupTime>
            <cooldownTime>4</cooldownTime>
            <renderTurretGraphic>true</renderTurretGraphic>
            <renderNodeProperties>
              <nodeClass>RsPandaLibrary.PawnRenderNode_MultiTurretGun</nodeClass>
              <workerClass>RsPandaLibrary.PawnRenderNodeWorker_MultiTurretGun</workerClass>
              <parentTagDef>Body</parentTagDef>
              <overrideMeshSize>(0.5, 0.5)</overrideMeshSize>
              <baseLayer>20</baseLayer>
              <pawnType>Any</pawnType>
              <drawData>
                <defaultData>
                  <rotationOffset>-90</rotationOffset>
                </defaultData>
                <dataWest>
                  <rotationOffset>90</rotationOffset>
                </dataWest>
              </drawData>
            </renderNodeProperties>
            <turretOffsetNorth>(0.6, 0, 0.8)</turretOffsetNorth>
            <turretOffsetSouth>(-0.6, 0, -0.8)</turretOffsetSouth>
            <turretOffsetEast>(0.8, 0, -0.6)</turretOffsetEast>
            <turretOffsetWest>(-0.8, 0, -0.6)</turretOffsetWest>
          </li>
        </turrets>
      </li>
    </value>
  </Operation>

</Patch>
