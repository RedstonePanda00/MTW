  <ThingDef ParentName="BaseGun">
    <defName>TW_Antiparticle_Rail_Mortar</defName>
    <label>Miniature Nuclear Projector</label>
    <description>Dubbed "Avatar of Annihilation," this orbital artillery system deploys when Doxa-0 anchors. Fires miniature nuclear warheads via gravity rails, bypassing shields, structural barriers, and energy shielding with delayed impact sequencing.</description>
    <tradeability>None</tradeability>
    <relicChance>0</relicChance>
    <destroyOnDrop>true</destroyOnDrop>
    <graphicData>
      <texPath>Things/None</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
	<uiIconPath>ModIcon/Antiparticle_Rail_Mortar</uiIconPath>
    <soundInteract>Interact_ChargeLance</soundInteract>
	<equippedAngleOffset>0</equippedAngleOffset>
    <weaponClasses>
      <li>LongShots</li>
      <li>RangedHeavy</li>
    </weaponClasses>
    <statBases>
	  <WorkToMake>20000</WorkToMake>
      <Mass>30</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>5</RangedWeapon_Cooldown>
    </statBases>
    <smeltable>false</smeltable>
    <verbs>
      <li>
        <isMortar>true</isMortar>
	    <ai_RangedAlawaysShootGroundBelowTarget>true</ai_RangedAlawaysShootGroundBelowTarget>
        <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <ai_TargetHasRangedAttackScoreOffset>500</ai_TargetHasRangedAttackScoreOffset>
	    <forcedMissRadius>5</forcedMissRadius>
        <verbClass>NCL.Verb_AdvancedShoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Shell_TW_Antiparticle_Rail_Mortar</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>500</range>
		<minRange>25</minRange>
        <burstShotCount>3</burstShotCount>
        <requireLineOfSight>false</requireLineOfSight>
        <ticksBetweenBurstShots>60</ticksBetweenBurstShots>
        <soundCast>Shot_HellsphereCannonGun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>50</muzzleFlashScale>
		<targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>false</canTargetPawns>
        </targetParams>
      </li>
    </verbs>
    <comps>
		<li Class="NCL.CompProperties_AdvancedAmmo">
			<primaryProjectileCount0>1</primaryProjectileCount0>
			<secondaryProjectile0>Shell_TW_EMP_Rail_Mortar</secondaryProjectile0>
			<secondaryProjectileCount0>1</secondaryProjectileCount0>
			
		</li>
    </comps>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1</cooldownTime>
      </li>
    </tools>
    <weaponTags Inherit="False">
      <li>TW_Antiparticle_Rail_Mortar</li>
    </weaponTags>
	<tradeTags>
      <li>NCLThings</li>
    </tradeTags>
  </ThingDef>
  
  <!-- Doxa multi-cell rear mounts: high-arc frag grenades, higher bomb damage than hand frag. -->
  <ThingDef ParentName="BaseFragGrenadeProjectile">
    <defName>Proj_MTW_Doxa_FragGrenade</defName>
    <label>doxa frag grenade shell</label>
    <thingClass>NCL.Projectiles.Projectile_HighArcExplosive</thingClass>
    <projectile>
      <damageAmountBase>80</damageAmountBase>
      <speed>40</speed>
      <arcHeightFactor>14</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
      <explosionRadius>4.9</explosionRadius>
      <explosionDelay>100</explosionDelay>
      <flyOverhead>true</flyOverhead>
    </projectile>
    <comps>
      <li Class="NCL.CompProperties_SmokeTrail">
        <intervalTicks>4</intervalTicks>
        <smokeSize>0.8</smokeSize>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>MTW_Doxa_RT_FragLauncher</defName>
    <label>Doxa frag grenade launcher</label>
    <description>High-arc frag grenade launcher for Doxa rear turret mounts. Seven-round burst.</description>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Grenades</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Grenade</soundInteract>
    <statBases>
      <Mass>10</Mass>
      <AccuracyTouch>1</AccuracyTouch>
      <AccuracyShort>1</AccuracyShort>
      <AccuracyMedium>1</AccuracyMedium>
      <AccuracyLong>1</AccuracyLong>
      <RangedWeapon_Cooldown>10</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Proj_MTW_Doxa_FragGrenade</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>70</range>
        <burstShotCount>7</burstShotCount>
        <ticksBetweenBurstShots>20</ticksBetweenBurstShots>
        <forcedMissRadius>4.9</forcedMissRadius>
        <requireLineOfSight>false</requireLineOfSight>
        <noiseRadius>4</noiseRadius>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>ThrowGrenade</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
      </li>
    </verbs>
    <tradeTags>
      <li>NCLThings</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="BaseWeapon">
    <defName>MeleeWeapon_Shellsplitter</defName>
    <label>Shellsplitter Laser Blade</label>
    <techLevel>Archotech</techLevel>
    <generateCommonality>0</generateCommonality>
    <description>High-frequency energy blade mounted on Shellsplitter for close-quarters disruption attacks.</description>
    <graphicData>
