<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <ThingDef Abstract="True" ParentName="BaseGun" Name="TW_Gun_QueenChargeBlasterHeavyBase">
    <label>War Queen heavy charge blaster</label>
    <description>Pulsed rapid-fire charge blaster built for area suppression. Reinforced cooling supports sustained lethal bursts; this war-queen-only pattern is deadlier than earlier variants.</description>
    <graphicData>
      <texPath>Weapons/WarqueenWeapon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1400</MarketValue>
      <Mass>22</Mass>
      <AccuracyTouch>0.78</AccuracyTouch>
      <AccuracyShort>0.54</AccuracyShort>
      <AccuracyMedium>0.31</AccuracyMedium>
      <AccuracyLong>0.18</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <techLevel>Spacer</techLevel>
    <tradeability>None</tradeability>
    <destroyOnDrop>true</destroyOnDrop>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>11.7</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

  <ThingDef ParentName="TW_Gun_QueenChargeBlasterHeavyBase">
    <defName>TW_Gun_QueenChargeBlasterHeavy</defName>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ChargeBlasterHeavy</defaultProjectile>
        <warmupTime>1.25</warmupTime>
        <range>33.9</range>
        <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
        <burstShotCount>15</burstShotCount>
        <soundCast>Shot_ChargeBlaster</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>TW_Gun_QueenChargeBlasterHeavy</li>
    </weaponTags>
    <modExtensions>
      <li Class="NCL.ThingDefExtension_WeaponCarryDrawOffsets">
        <weaponCarryDrawOffsets>
          <north>
            <drawOffset>(0.5, 0.0, -0.35)</drawOffset>
          </north>
          <east>
            <drawOffset>(-0.5, 0.0, -0.35)</drawOffset>
          </east>
          <south>
            <drawOffset>(-0.5, 0.0, -0.35)</drawOffset>
          </south>
          <west>
            <drawOffset>(0.5, 0.0, -0.35)</drawOffset>
          </west>
        </weaponCarryDrawOffsets>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
